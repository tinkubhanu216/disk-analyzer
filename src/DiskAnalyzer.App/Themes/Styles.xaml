<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:DiskAnalyzer.App.Converters">

    <!-- Converters -->
    <conv:BytesConverter x:Key="Bytes" />
    <conv:PercentConverter x:Key="Percent" />
    <conv:CountConverter x:Key="Count" />
    <conv:LocalTimeConverter x:Key="LocalTime" />
    <conv:DurationConverter x:Key="Duration" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:NullToVisibilityConverter x:Key="NullToVis" />
    <conv:InverseBoolConverter x:Key="Not" />
    <conv:CategoryBrushConverter x:Key="CategoryBrush" />
    <conv:EnumEqualsConverter x:Key="EnumEquals" />

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Default app brushes (replaced at runtime by ThemeService for light/dark). -->
    <SolidColorBrush x:Key="App.TextPrimary" Color="#E4000000" />
    <SolidColorBrush x:Key="App.TextSecondary" Color="#9E000000" />
    <SolidColorBrush x:Key="App.TextTertiary" Color="#72000000" />
    <SolidColorBrush x:Key="App.CardBackground" Color="#FFFBFBFB" />
    <SolidColorBrush x:Key="App.CardBackgroundAlt" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="App.CardStroke" Color="#17000000" />
    <SolidColorBrush x:Key="App.PageBackground" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="App.NavBackground" Color="#FFEBEBEB" />
    <SolidColorBrush x:Key="App.SubtleFill" Color="#0A000000" />
    <SolidColorBrush x:Key="App.SubtleFillHover" Color="#12000000" />
    <SolidColorBrush x:Key="App.Track" Color="#1A000000" />
    <SolidColorBrush x:Key="App.Accent" Color="#FF0067C0" />
    <SolidColorBrush x:Key="App.AccentStrong" Color="#FF005A9E" />
    <SolidColorBrush x:Key="App.AccentSubtle" Color="#1F0067C0" />
    <SolidColorBrush x:Key="App.OnAccent" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="App.Warning" Color="#FF9D5D00" />
    <SolidColorBrush x:Key="App.WarningBackground" Color="#26FFB900" />
    <SolidColorBrush x:Key="App.Danger" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="App.Success" Color="#FF0F7B0F" />
    <SolidColorBrush x:Key="App.InfoBackground" Color="#1A0067C0" />
    <SolidColorBrush x:Key="App.FolderIcon" Color="#FFFFC83D" />
    <SolidColorBrush x:Key="App.TreemapBackground" Color="#FFF3F3F3" />

    <!-- Typography -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="StatValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}" />
    </Style>
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}" />
    </Style>

    <!-- Surfaces -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource App.CardBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.CardStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="InfoBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource App.InfoBackground}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style x:Key="WarningBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource App.WarningBackground}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- Buttons -->
    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource App.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource App.OnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.78" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SubtleButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="cp" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource App.SubtleFillHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource App.SubtleFill}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="cp" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
        <Setter Property="Background" Value="{DynamicResource App.SubtleFill}" />
        <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource App.Accent}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="content" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="content" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="content" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="BreadcrumbButton" TargetType="Button" BasedOn="{StaticResource LinkButton}">
        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="4,2" />
    </Style>

    <!-- Navigation list -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="4,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="bg" CornerRadius="5" Background="Transparent" Padding="12,9" />
                        <Border x:Name="indicator" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                Background="{DynamicResource App.Accent}" Visibility="Collapsed" Margin="0,0,0,0" />
                        <ContentPresenter Margin="14,9,12,9" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource App.SubtleFill}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource App.SubtleFillHover}" />
                            <Setter TargetName="indicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

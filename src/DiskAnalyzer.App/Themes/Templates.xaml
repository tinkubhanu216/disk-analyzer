<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:DiskAnalyzer.App.ViewModels"
                    xmlns:c="clr-namespace:DiskAnalyzer.App.Controls">

    <!-- Drive card (Drives page and Overview welcome) -->
    <DataTemplate DataType="{x:Type vm:DriveCardViewModel}">
        <Border Style="{StaticResource Card}" Width="320" Margin="0,0,12,12" Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.RowSpan="2" Width="40" Height="40" CornerRadius="8" Background="{DynamicResource App.AccentSubtle}" Margin="0,0,12,0" VerticalAlignment="Top">
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="20" HorizontalAlignment="Center" Foreground="{DynamicResource App.Accent}" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource Body}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="{Binding UtilizationText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                <c:UsageBar Grid.Row="2" Grid.ColumnSpan="3" Height="8" Margin="0,14,0,6" Value="{Binding UsedRatio}" Radius="4"
                            TrackBrush="{DynamicResource App.Track}" Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
                    <c:UsageBar.Style>
                        <Style TargetType="c:UsageBar">
                            <Setter Property="BarBrush" Value="{DynamicResource App.Accent}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNearlyFull}" Value="True">
                                    <Setter Property="BarBrush" Value="{DynamicResource App.Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </c:UsageBar.Style>
                </c:UsageBar>
                <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Text="{Binding UsageLine}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Style="{StaticResource AccentButton}" Command="{Binding ScanCommand}" IsEnabled="{Binding IsReady}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Foreground="{DynamicResource App.OnAccent}" Margin="0,0,6,0" />
                            <TextBlock Text="Scan drive" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource OutlineButton}" Margin="8,0,0,0" Command="{Binding OpenCachedCommand}"
                            Visibility="{Binding CachedScan, Converter={StaticResource NullToVis}}" ToolTip="{Binding CachedText}">
                        <TextBlock Text="Open last scan" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Statistic tile -->
    <DataTemplate DataType="{x:Type vm:StatTile}">
        <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="14,12" MinWidth="150">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="14" Foreground="{DynamicResource App.Accent}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
                </StackPanel>
                <TextBlock Text="{Binding Value}" Style="{StaticResource StatValue}" Margin="0,6,0,2" />
                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" ToolTip="{Binding Detail}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Icon + name cell for node rows -->
    <DataTemplate x:Key="NodeNameCell" DataType="{x:Type vm:NodeItemViewModel}">
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{Binding IconBrush}" FontSize="15" Margin="0,0,8,0" />
            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" ToolTip="{Binding FullPath}" />
            <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" Margin="8,0,0,0" FontStyle="Italic"
                       Visibility="{Binding Note, Converter={StaticResource NullToVis}}" />
        </StackPanel>
    </DataTemplate>

    <!-- Path cell (name + parent folder) -->
    <DataTemplate x:Key="NodePathCell" DataType="{x:Type vm:NodeItemViewModel}">
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{Binding IconBrush}" FontSize="15" Margin="0,0,8,0" />
            <StackPanel>
                <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" />
                <TextBlock Text="{Binding ParentPath}" Style="{StaticResource Caption}" FontSize="11" ToolTip="{Binding FullPath}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Size + bar cell -->
    <DataTemplate x:Key="NodeShareCell" DataType="{x:Type vm:NodeItemViewModel}">
        <Grid Width="100">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>
            <c:UsageBar Height="6" Value="{Binding ParentRatio}" BarBrush="{Binding BarBrush}" TrackBrush="{DynamicResource App.Track}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding PercentOfParentText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>

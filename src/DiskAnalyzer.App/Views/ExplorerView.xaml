<UserControl x:Class="DiskAnalyzer.App.Views.ExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DiskAnalyzer.App.ViewModels"
             xmlns:views="clr-namespace:DiskAnalyzer.App.Views"
             xmlns:c="clr-namespace:DiskAnalyzer.App.Controls">
    <Grid>
        <TextBlock Text="Scan a drive or folder to explore it." Style="{StaticResource PageSubtitle}" FontSize="15" Margin="0,8,0,0"
                   Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
        <DockPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <!-- Title + navigation -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SubtleButton}" Command="{Binding GoBackCommand}" IsEnabled="{Binding CanGoBack}" ToolTip="Back (Alt+Left)">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource SubtleButton}" Command="{Binding GoForwardCommand}" IsEnabled="{Binding CanGoForward}" ToolTip="Forward (Alt+Right)">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72A;" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource SubtleButton}" Command="{Binding GoUpCommand}" ToolTip="Up one level (Backspace)">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74A;" FontSize="14" />
                    </Button>
                </StackPanel>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Breadcrumbs}" Margin="8,0" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BreadcrumbItem}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource BreadcrumbButton}" Content="{Binding Name}"
                                        Command="{Binding DataContext.NavigateBreadcrumbCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="10" Margin="2,0" Foreground="{DynamicResource App.TextTertiary}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Grid.Column="2" Style="{StaticResource AccentButton}" Command="{Binding VisualizeCommand}" CommandParameter="{x:Null}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE80A;" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource App.OnAccent}" />
                        <TextBlock Text="Visualize Storage" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Filters -->
            <!-- One row that always fits: the name box absorbs the spare width. -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" MinWidth="110" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" DisplayMemberPath="Label" Margin="0,0,8,0" ToolTip="Sort" />
                <TextBox Grid.Column="1" Text="{Binding NameFilter, UpdateSourceTrigger=PropertyChanged, Delay=200}" Margin="0,0,8,0" c:Hint.Text="Name contains…" ToolTip="Filter by file or folder name (wildcards * and ? supported)" x:Name="NameFilterBox" />
                <TextBox Grid.Column="2" Text="{Binding ExtensionFilter, UpdateSourceTrigger=PropertyChanged, Delay=200}" Margin="0,0,8,0" c:Hint.Text="Extensions" ToolTip="Extensions, e.g. mp4, mkv" />
                <ComboBox Grid.Column="3" ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Label" Margin="0,0,8,0" ToolTip="File type" />
                <TextBox Grid.Column="4" Text="{Binding MinSizeFilter, UpdateSourceTrigger=PropertyChanged, Delay=300}" Margin="0,0,10,0" c:Hint.Text="Min size" ToolTip="Minimum size, e.g. 100 MB" />
                <CheckBox Grid.Column="5" Content="Folders" IsChecked="{Binding ShowFolders}" Margin="0,0,4,0" MinWidth="0" VerticalAlignment="Center" />
                <CheckBox Grid.Column="6" Content="Files" IsChecked="{Binding ShowFiles}" Margin="0,0,4,0" MinWidth="0" VerticalAlignment="Center" />
                <Button Grid.Column="7" Style="{StaticResource LinkButton}" Command="{Binding ClearFiltersCommand}" VerticalAlignment="Center" Margin="6,0,0,0"
                        Visibility="{Binding IsFiltered, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Clear filters" />
                </Button>
            </Grid>
            <TextBlock DockPanel.Dock="Top" Text="{Binding FilterError}" Foreground="{DynamicResource App.Danger}" FontSize="12" Margin="0,0,0,6" Visibility="{Binding FilterError, Converter={StaticResource NullToVis}}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" MinWidth="140" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="230" />
                </Grid.ColumnDefinitions>

                <!-- Folder tree (lazy) -->
                <Border Style="{StaticResource Card}" Padding="4">
                    <TreeView x:Name="FolderTree" ItemsSource="{Binding RootItems}" Background="Transparent" BorderThickness="0"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:FolderTreeItemViewModel}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding SizeText}">
                                    <TextBlock FontSize="13" Margin="0,0,6,0" Foreground="{DynamicResource App.FolderIcon}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                <Setter Property="Text" Value="&#xE8B7;" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInaccessible}" Value="True">
                                                        <Setter Property="Text" Value="&#xE72E;" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource App.TextPrimary}" />
                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Border>
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent" ResizeBehavior="PreviousAndNext" />

                <!-- Contents of current folder -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="14,10,14,6">
                            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold">
                                <Run Text="{Binding CurrentFolderItem.Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding CurrentFolderItem.SizeText, Mode=OneWay}" Foreground="{DynamicResource App.TextSecondary}" FontWeight="Normal" />
                            </TextBlock>
                            <TextBlock Text="{Binding ItemsSummary}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                        </Grid>
                        <ListView x:Name="ItemsList" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" MouseDoubleClick="ItemsList_MouseDoubleClick"
                                  KeyDown="ItemsList_KeyDown" Background="Transparent" BorderThickness="0"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                  AutomationProperties.Name="Folder contents" SizeChanged="ItemsList_SizeChanged">
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Open" Command="{Binding OpenCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="Visualize Storage" Command="{Binding VisualizeCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="Show in Windows Explorer" Command="{Binding ShowInWindowsExplorerCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="Copy path" Command="{Binding CopyPathCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Separator />
                                    <MenuItem Header="Scan this folder" Command="{Binding ScanThisFolderCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Name" Width="200" CellTemplate="{StaticResource NodeNameCell}" />
                                    <GridViewColumn Header="Size" Width="74">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:NodeItemViewModel}">
                                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource Body}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="% of parent" Width="110" CellTemplate="{StaticResource NodeShareCell}" />
                                    <GridViewColumn Header="% of drive" Width="82">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:NodeItemViewModel}">
                                                <TextBlock Text="{Binding PercentOfDriveText}" Style="{StaticResource Caption}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Files" Width="58">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:NodeItemViewModel}">
                                                <TextBlock Text="{Binding FileCountText}" Style="{StaticResource Caption}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Modified" Width="92">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:NodeItemViewModel}">
                                                <TextBlock Text="{Binding ModifiedDateText}" Style="{StaticResource Caption}" ToolTip="{Binding ModifiedText}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </Border>

                <!-- Details -->
                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
                                        <Setter Property="Text" Value="Selected item" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                                <Setter Property="Text" Value="This folder" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <views:NodeDetailsPanel DataContext="{Binding DetailsItem}" />
                            <StackPanel Margin="0,14,0,0">
                                <Button Style="{StaticResource OutlineButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6"
                                        Command="{Binding ShowInWindowsExplorerCommand}" CommandParameter="{Binding DetailsItem}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Open in Windows Explorer" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource OutlineButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6"
                                        Command="{Binding VisualizeCommand}" CommandParameter="{Binding DetailsItem}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE80A;" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Show in heatmap" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource OutlineButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6"
                                        Command="{Binding CopyPathCommand}" CommandParameter="{Binding DetailsItem}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Copy path" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource OutlineButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Command="{Binding ScanThisFolderCommand}" CommandParameter="{Binding DetailsItem}"
                                        Visibility="{Binding DetailsItem.IsDirectory, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Rescan this folder only" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>

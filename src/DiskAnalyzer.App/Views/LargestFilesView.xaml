<UserControl x:Class="DiskAnalyzer.App.Views.LargestFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DiskAnalyzer.App.ViewModels"
             xmlns:c="clr-namespace:DiskAnalyzer.App.Controls">
    <UserControl.Resources>
        <ContextMenu x:Key="RowMenu" x:Shared="False">
            <MenuItem Header="Show in Folder Explorer" Command="{Binding ShowLocationCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Show in heatmap" Command="{Binding ShowInHeatmapCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Open in Windows Explorer" Command="{Binding ShowInWindowsExplorerCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Copy path" Command="{Binding CopyPathCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>
        <GridView x:Key="RankedColumns" x:Shared="False">
            <GridViewColumn Header="Name" Width="420" CellTemplate="{StaticResource NodePathCell}" />
            <GridViewColumn Header="Size" Width="100">
                <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type vm:NodeItemViewModel}">
                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="% of scan" Width="150">
                <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type vm:NodeItemViewModel}">
                        <Grid Width="130">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="50" />
                            </Grid.ColumnDefinitions>
                            <c:UsageBar Height="6" Value="{Binding ScopeRatio}" BarBrush="{Binding BarBrush}" TrackBrush="{DynamicResource App.Track}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding PercentOfScope, Converter={StaticResource Percent}}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="% of drive" Width="80">
                <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type vm:NodeItemViewModel}">
                        <TextBlock Text="{Binding PercentOfDriveText}" Style="{StaticResource Caption}" />
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Modified" Width="130">
                <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type vm:NodeItemViewModel}">
                        <TextBlock Text="{Binding ModifiedText}" Style="{StaticResource Caption}" />
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Type" Width="110">
                <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type vm:NodeItemViewModel}">
                        <TextBlock Text="{Binding CategoryText}" Style="{StaticResource Caption}" />
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
        </GridView>
    </UserControl.Resources>
    <Grid>
        <TextBlock Text="Scan a drive or folder to list its largest items." Style="{StaticResource PageSubtitle}" FontSize="15" Margin="0,8,0,0"
                   Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
        <DockPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Largest Files &amp; Folders" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Double-click an item to open its location in Folder Explorer. Right-click for more actions." Style="{StaticResource PageSubtitle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <TextBlock Text="Show top" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding CountOptions}" SelectedItem="{Binding SelectedCount}" Width="90" />
                </StackPanel>
            </Grid>
            <TabControl>
                <TabItem Header="Largest files">
                    <DockPanel Margin="0,8,0,0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Export list:" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Style="{StaticResource OutlineButton}" Content="CSV" Command="{Binding ExportTopFilesCommand}" CommandParameter="csv" Margin="0,0,6,0" />
                            <Button Style="{StaticResource OutlineButton}" Content="Excel" Command="{Binding ExportTopFilesCommand}" CommandParameter="xlsx" Margin="0,0,6,0" />
                            <Button Style="{StaticResource OutlineButton}" Content="JSON" Command="{Binding ExportTopFilesCommand}" CommandParameter="json" />
                        </StackPanel>
                        <ListView ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" View="{StaticResource RankedColumns}" ContextMenu="{StaticResource RowMenu}"
                                  MouseDoubleClick="List_MouseDoubleClick" Background="Transparent" BorderThickness="0"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" />
                    </DockPanel>
                </TabItem>
                <TabItem Header="Largest folders">
                    <DockPanel Margin="0,8,0,0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Export list:" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Style="{StaticResource OutlineButton}" Content="CSV" Command="{Binding ExportTopFoldersCommand}" CommandParameter="csv" Margin="0,0,6,0" />
                            <Button Style="{StaticResource OutlineButton}" Content="Excel" Command="{Binding ExportTopFoldersCommand}" CommandParameter="xlsx" Margin="0,0,6,0" />
                            <Button Style="{StaticResource OutlineButton}" Content="JSON" Command="{Binding ExportTopFoldersCommand}" CommandParameter="json" />
                            <TextBlock Text="Nested folders are included, so a parent and its child can both appear." Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        </StackPanel>
                        <ListView ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" View="{StaticResource RankedColumns}" ContextMenu="{StaticResource RowMenu}"
                                  MouseDoubleClick="List_MouseDoubleClick" Background="Transparent" BorderThickness="0"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" />
                    </DockPanel>
                </TabItem>
                <TabItem Header="Duplicate files">
                    <DockPanel Margin="0,8,0,0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Minimum file size" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding DuplicateMinSize, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,10,0" />
                            <Button Style="{StaticResource AccentButton}" Content="Find duplicates" Command="{Binding FindDuplicatesCommand}"
                                    IsEnabled="{Binding IsFindingDuplicates, Converter={StaticResource Not}}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource OutlineButton}" Content="Cancel" Command="{Binding CancelDuplicatesCommand}"
                                    Visibility="{Binding IsFindingDuplicates, Converter={StaticResource BoolToVis}}" />
                            <ProgressBar Width="160" Height="4" Margin="12,0,0,0" Maximum="100" Value="{Binding DuplicateProgress, Mode=OneWay}"
                                         Visibility="{Binding IsFindingDuplicates, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding DuplicateSummary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Files are compared by size, then by a hash of their first and last 64 KB, then by a full SHA-256 hash. Files are only read, never changed. Hard links are not reported as duplicates." />
                        <ListBox ItemsSource="{Binding DuplicateGroups}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DuplicateGroupViewModel}">
                                    <Expander Header="{Binding Header}" Margin="0,2">
                                        <ItemsControl ItemsSource="{Binding Items}" Margin="24,4,0,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:NodeItemViewModel}">
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding FullPath}" Style="{StaticResource Body}" ToolTip="{Binding FullPath}" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <TextBlock Text="{Binding ModifiedText}" Style="{StaticResource Caption}" Margin="12,0" />
                                                            <Button Style="{StaticResource LinkButton}" Command="{Binding DataContext.ShowInWindowsExplorerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                                <TextBlock Text="Open location" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</UserControl>

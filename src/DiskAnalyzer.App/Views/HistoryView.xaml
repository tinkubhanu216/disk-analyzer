<UserControl x:Class="DiskAnalyzer.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DiskAnalyzer.App.ViewModels">
    <UserControl.Resources>
        <GridView x:Key="ChangeColumns" x:Shared="False">
            <GridViewColumn Header="Path" Width="560">
                <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type vm:ChangeRowViewModel}">
                        <TextBlock Text="{Binding Path}" Style="{StaticResource Body}" ToolTip="{Binding Path}" />
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Before" Width="100" DisplayMemberBinding="{Binding OldText}" />
            <GridViewColumn Header="After" Width="100" DisplayMemberBinding="{Binding NewText}" />
            <GridViewColumn Header="Change" Width="110">
                <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type vm:ChangeRowViewModel}">
                        <TextBlock Text="{Binding DeltaText}" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource App.Success}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIncrease}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource App.Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
        </GridView>
    </UserControl.Resources>
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Scan History" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource OutlineButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource AccentButton}" Command="{Binding CompareCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource App.OnAccent}" />
                        <TextBlock Text="Compare ticked scans" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="0,0,0,6" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="140" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="0">
                <ListView ItemsSource="{Binding Scans}" SelectedItem="{Binding SelectedScan}" MouseDoubleClick="Scans_MouseDoubleClick"
                          Background="Transparent" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open as historical result" Command="{Binding OpenCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Delete from history" Command="{Binding DeleteCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="44">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:HistoryRowViewModel}">
                                        <CheckBox IsChecked="{Binding IsChecked}" ToolTip="Select for comparison" MinWidth="0" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Scanned" Width="150" DisplayMemberBinding="{Binding DateText}" />
                            <GridViewColumn Header="Drive" Width="170" DisplayMemberBinding="{Binding Scan.DriveName}" />
                            <GridViewColumn Header="Location" Width="230" DisplayMemberBinding="{Binding Scan.RootPath}" />
                            <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding SizeText}" />
                            <GridViewColumn Header="Files" Width="90" DisplayMemberBinding="{Binding FilesText}" />
                            <GridViewColumn Header="Folders" Width="80" DisplayMemberBinding="{Binding FoldersText}" />
                            <GridViewColumn Header="Duration" Width="80" DisplayMemberBinding="{Binding DurationText}" />
                            <GridViewColumn Header="Status" Width="170" DisplayMemberBinding="{Binding StatusText}" />
                            <GridViewColumn Header="Stored" Width="110" DisplayMemberBinding="{Binding StoredText}" />
                            <GridViewColumn Header="Scanner" Width="150" DisplayMemberBinding="{Binding Scan.ProviderName}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Style="{StaticResource OutlineButton}" Command="{Binding OpenCommand}" CommandParameter="{x:Null}" Margin="0,0,8,0" Content="Open selected" />
                <Button Style="{StaticResource OutlineButton}" Command="{Binding DeleteCommand}" CommandParameter="{x:Null}" Content="Delete selected" />
            </StackPanel>

            <!-- Comparison -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Height="380"
                    Visibility="{Binding Comparison, Converter={StaticResource NullToVis}}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <StackPanel>
                            <TextBlock Text="{Binding ComparisonTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding ComparisonSummary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        </StackPanel>
                        <Button Style="{StaticResource SubtleButton}" Command="{Binding CloseComparisonCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Close comparison">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>
                    <TabControl>
                        <TabItem Header="New files"><ListView ItemsSource="{Binding AddedFiles}" View="{StaticResource ChangeColumns}" Background="Transparent" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" /></TabItem>
                        <TabItem Header="Deleted files"><ListView ItemsSource="{Binding RemovedFiles}" View="{StaticResource ChangeColumns}" Background="Transparent" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" /></TabItem>
                        <TabItem Header="Folders that grew"><ListView ItemsSource="{Binding GrownFolders}" View="{StaticResource ChangeColumns}" Background="Transparent" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" /></TabItem>
                        <TabItem Header="Folders that shrank"><ListView ItemsSource="{Binding ShrunkFolders}" View="{StaticResource ChangeColumns}" Background="Transparent" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" /></TabItem>
                        <TabItem Header="New folders"><ListView ItemsSource="{Binding AddedFolders}" View="{StaticResource ChangeColumns}" Background="Transparent" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" /></TabItem>
                        <TabItem Header="Deleted folders"><ListView ItemsSource="{Binding RemovedFolders}" View="{StaticResource ChangeColumns}" Background="Transparent" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" /></TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>

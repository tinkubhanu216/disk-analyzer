<UserControl x:Class="DiskAnalyzer.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SettingRow" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style x:Key="SettingTitle" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="SettingHint" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="GroupTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left" Margin="0,0,16,16">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Changes are saved automatically. Scan options apply to the next scan." Style="{StaticResource PageSubtitle}" />

            <TextBlock Text="Appearance" Style="{StaticResource GroupTitle}" />
            <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}" DisplayMemberPath="Label" Width="220" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="Theme" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="Light, dark, or follow the Windows app mode." Style="{StaticResource SettingHint}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="Scanning" Style="{StaticResource GroupTitle}" />
            <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding UseMftWhenAvailable}" VerticalAlignment="Center" MinWidth="0" />
                    <StackPanel>
                        <TextBlock Text="Read the NTFS Master File Table when running as administrator" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="Much faster for whole NTFS drives and counts hard links once. Used only when the app is already elevated; otherwise standard enumeration is used automatically." Style="{StaticResource SettingHint}" />
                        <TextBlock Text="{Binding ElevationText}" Style="{StaticResource SettingHint}" Foreground="{DynamicResource App.Accent}" />
                        <Button Style="{StaticResource LinkButton}" Command="{Binding RestartElevatedCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                Visibility="{Binding IsElevated, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                            <TextBlock Text="Restart as administrator" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding IncludeHidden}" VerticalAlignment="Center" MinWidth="0" />
                    <StackPanel>
                        <TextBlock Text="Include hidden files and folders" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="Hidden items often hold a lot of data (AppData, caches). Recommended." Style="{StaticResource SettingHint}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding IncludeSystem}" VerticalAlignment="Center" MinWidth="0" />
                    <StackPanel>
                        <TextBlock Text="Include system files" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="Includes pagefile.sys, hiberfil.sys, Windows component store and similar files." Style="{StaticResource SettingHint}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding DeduplicateHardLinks}" VerticalAlignment="Center" MinWidth="0" />
                    <StackPanel>
                        <TextBlock Text="Count hard-linked files once (standard scanning)" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="Windows\WinSxS and similar folders use hard links, which Explorer-style totals count once per name. Turning this on gives more accurate totals but opens every file's metadata, so scans are slower." Style="{StaticResource SettingHint}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding FollowReparsePoints}" VerticalAlignment="Center" MinWidth="0" />
                    <StackPanel>
                        <TextBlock Text="Follow junctions and symbolic links" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="Off by default. When on, linked folders are scanned once each with loop protection, but data reachable through a link may be counted twice." Style="{StaticResource SettingHint}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding ConcurrencyOptions}" SelectedItem="{Binding MaxConcurrency}" Width="100" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="Parallel scanning workers" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="{Binding ConcurrencyHint}" Style="{StaticResource SettingHint}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="Scan history and cache" Style="{StaticResource GroupTitle}" />
            <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding SaveScanHistory}" VerticalAlignment="Center" MinWidth="0" />
                    <StackPanel>
                        <TextBlock Text="Save completed scans to history" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="Needed for comparing scans and reopening results without rescanning. Cancelled scans are never saved." Style="{StaticResource SettingHint}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding ThresholdOptions}" SelectedItem="{Binding SelectedThreshold}" DisplayMemberPath="Label" Width="280" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="Files stored per scan" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="All folders and their exact totals are always stored. Storing small files makes comparisons more detailed but the database much larger." Style="{StaticResource SettingHint}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                    <TextBox DockPanel.Dock="Right" Text="{Binding MaxScansPerRoot, UpdateSourceTrigger=LostFocus}" Width="80" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="Scans kept per location" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="Older scans of the same drive or folder are removed automatically." Style="{StaticResource SettingHint}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding OfferCachedResults}" VerticalAlignment="Center" MinWidth="0" />
                    <StackPanel>
                        <TextBlock Text="Offer the last scan of each drive" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="Shows an 'Open last scan' button on drive cards. Cached results are always labelled with their date and never used for current drive usage." Style="{StaticResource SettingHint}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Command="{Binding ClearHistoryCommand}" Content="Clear history" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="Clear scan history" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="Deletes stored scans from the app's database. Your files are never touched." Style="{StaticResource SettingHint}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="Storage heatmap" Style="{StaticResource GroupTitle}" />
            <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                    <Slider DockPanel.Dock="Right" Minimum="1" Maximum="12" Value="{Binding TreemapMinTilePixels}" Width="200" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingTitle}">
                            <Run Text="Smallest tile size: " /><Run Text="{Binding TreemapMinTilePixels, Mode=OneWay}" /><Run Text=" px" />
                        </TextBlock>
                        <TextBlock Text="Items that would be smaller are merged into a single 'smaller items' tile. Lower values show more detail; higher values render faster." Style="{StaticResource SettingHint}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="About" Style="{StaticResource GroupTitle}" />
            <Border Style="{StaticResource SettingRow}">
                <StackPanel>
                    <TextBlock Text="Disk Analyzer" Style="{StaticResource SettingTitle}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CopyrightText}" Style="{StaticResource SettingHint}" Foreground="{DynamicResource App.TextPrimary}" />
                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource SettingHint}" />
                    <TextBlock Text="Read-only by design: scanning, exporting and comparing never modify, move or delete files on your drives." Style="{StaticResource SettingHint}" />
                    <TextBlock Style="{StaticResource SettingHint}">
                        <Run Text="Data folder: " /><Run Text="{Binding DataFolder, Mode=OneWay}" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource OutlineButton}" Command="{Binding OpenDataFolderCommand}" Content="Open data folder" Margin="0,0,8,0" />
                        <Button Style="{StaticResource OutlineButton}" Command="{Binding OpenLogFolderCommand}" Content="Open logs" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

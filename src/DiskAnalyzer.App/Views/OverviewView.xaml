<UserControl x:Class="DiskAnalyzer.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DiskAnalyzer.App.ViewModels"
             xmlns:c="clr-namespace:DiskAnalyzer.App.Controls"
             xmlns:tm="clr-namespace:DiskAnalyzer.Visualization.Interaction;assembly=DiskAnalyzer.Visualization">
    <Grid>
        <!-- Welcome: nothing scanned yet -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <StackPanel Margin="0,4,0,0">
                <TextBlock Text="Welcome to Disk Analyzer" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,0,0,16" MaxWidth="820" HorizontalAlignment="Left"
                           Text="Pick a drive to see exactly where your space goes: folder sizes, the largest files, file types and an interactive storage heatmap. Scanning is read-only — nothing on your drives is changed." />
                <Border Style="{StaticResource InfoBar}" HorizontalAlignment="Left" Margin="0,0,0,16" MaxWidth="980">
                    <TextBlock Text="{Binding Drives.ScanModeText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Foreground="{DynamicResource App.TextPrimary}" />
                </Border>
                <ItemsControl ItemsSource="{Binding Drives.Drives}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Button Style="{StaticResource OutlineButton}" Command="{Binding ScanFolderCommand}" HorizontalAlignment="Left" Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Scan a specific folder…" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <!-- Results dashboard -->
        <Grid Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,8">
                <TextBlock Text="Overview" Style="{StaticResource PageTitle}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding OpenExplorerCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEC50;" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Browse folders" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentButton}" Command="{Binding VisualizeCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE80A;" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource App.OnAccent}" />
                            <TextBlock Text="Visualize Storage" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding Tiles}" Margin="0,0,-12,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" MinWidth="300" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="4*" MinWidth="260" />
                </Grid.ColumnDefinitions>

                <!-- Storage by folder -->
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Storage by folder" Style="{StaticResource SectionTitle}" />
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding UsageComparison}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0" TextTrimming="None">
                            <TextBlock.ToolTip>
                                <ToolTip MaxWidth="420">
                                    <TextBlock Text="{Binding DifferenceExplanation}" TextWrapping="Wrap" />
                                </ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <Expander DockPanel.Dock="Bottom" Header="Why don't folder totals match drive usage?" Margin="0,8,0,0" FontSize="12">
                            <TextBlock Text="{Binding DifferenceExplanation}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0" />
                        </Expander>
                        <ListBox ItemsSource="{Binding TopFolders}" SelectedItem="{Binding SelectedFolder}" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:NodeItemViewModel}">
                                    <Grid Margin="0,3" ToolTip="{Binding FullPath}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{Binding IconBrush}" FontSize="14" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Margin="8,0,0,0">
                                            <Run Text="{Binding SizeText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding PercentOfParentText, Mode=OneWay}" />
                                        </TextBlock>
                                        <c:UsageBar Grid.Row="1" Grid.ColumnSpan="2" Height="5" Margin="0,5,0,0" Value="{Binding ParentRatio}"
                                                    BarBrush="{DynamicResource App.Accent}" TrackBrush="{DynamicResource App.Track}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Mini treemap -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="16,14,16,8">
                            <TextBlock Text="Storage visualization" Style="{StaticResource SectionTitle}" Margin="0" />
                            <Button Style="{StaticResource LinkButton}" Command="{Binding VisualizeCommand}" HorizontalAlignment="Right">
                                <TextBlock Text="Open heatmap ›" />
                            </Button>
                        </Grid>
                        <Border CornerRadius="0,0,8,8" ClipToBounds="True" Margin="1">
                            <tm:TreemapControl Tree="{Binding Tree}" DriveCapacityBytes="{Binding DriveCapacity}" ShowLabels="True" Cursor="Hand"
                                               IsDark="{Binding IsDarkTheme}"
                                               x:Name="MiniTreemap" NodeClick="MiniTreemap_NodeClick" />
                        </Border>
                    </DockPanel>
                </Border>

                <!-- Largest items + categories -->
                <Grid Grid.Column="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Largest files" Style="{StaticResource SectionTitle}" />
                            <ListBox ItemsSource="{Binding LargestFiles}" SelectedItem="{Binding SelectedFile}" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:NodeItemViewModel}">
                                        <Grid Margin="0,2" ToolTip="{Binding FullPath}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{Binding IconBrush}" FontSize="14" Margin="0,0,8,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" />
                                                <TextBlock Text="{Binding ParentPath}" Style="{StaticResource Caption}" FontSize="11" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="File types" Style="{StaticResource SectionTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <c:DonutChart Width="104" Height="104" RingThickness="16" Segments="{Binding CategorySegments}" CenterTitle="{Binding ScannedTotalText}"
                                              Foreground="{DynamicResource App.TextPrimary}" />
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Categories}" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:CategoryRow}">
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="{Binding Brush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Caption}" />
                                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

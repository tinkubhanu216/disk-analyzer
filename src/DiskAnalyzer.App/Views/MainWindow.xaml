<Window x:Class="DiskAnalyzer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DiskAnalyzer.App.ViewModels"
        xmlns:views="clr-namespace:DiskAnalyzer.App.Views"
        Title="{Binding WindowTitle}" Icon="/Resources/AppIcon.ico"
        Width="1440" Height="900" MinWidth="1024" MinHeight="660"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}"><views:OverviewView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DrivesViewModel}"><views:DrivesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExplorerViewModel}"><views:ExplorerView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HeatmapViewModel}"><views:HeatmapView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LargestFilesViewModel}"><views:LargestFilesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:FileTypesViewModel}"><views:FileTypesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><views:HistoryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SearchViewModel}"><views:SearchView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="18,10,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Resources/AppLogo.png" Width="24" Height="24" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="Disk Analyzer" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource App.TextPrimary}" VerticalAlignment="Center" />
            </StackPanel>

            <Grid Grid.Column="1" MaxWidth="560" HorizontalAlignment="Left" Margin="12,0">
                <TextBox x:Name="SearchBox" Text="{Binding GlobalSearchText, UpdateSourceTrigger=PropertyChanged}" Padding="34,6,10,6" MinWidth="380"
                         VerticalContentAlignment="Center" AutomationProperties.Name="Search scanned files and folders" />
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="14" Margin="12,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"
                           Foreground="{DynamicResource App.TextTertiary}" />
                <TextBlock Text="Search files, folders, extensions (e.g. *.iso)…" Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource App.TextTertiary}"
                           Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SubtleButton}" Click="ExportButton_Click" IsEnabled="{Binding HasResult}" ToolTip="Export scan results" x:Name="ExportButton">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEDE1;" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock Text="Export" Foreground="{DynamicResource App.TextPrimary}" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" Margin="6,0,0,0" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="All items — CSV" Command="{Binding ExportCommand}" CommandParameter="csv:all" />
                            <MenuItem Header="All items — Excel" Command="{Binding ExportCommand}" CommandParameter="xlsx:all" />
                            <MenuItem Header="All items — JSON" Command="{Binding ExportCommand}" CommandParameter="json:all" />
                            <Separator />
                            <MenuItem Header="Folders only — CSV" Command="{Binding ExportCommand}" CommandParameter="csv:folders" />
                            <MenuItem Header="Folders only — Excel" Command="{Binding ExportCommand}" CommandParameter="xlsx:folders" />
                            <Separator />
                            <MenuItem Header="Top 100 largest files…" Command="{Binding ExportCommand}" CommandParameter="xlsx:topfiles" />
                            <MenuItem Header="Top 100 largest folders…" Command="{Binding ExportCommand}" CommandParameter="xlsx:topfolders" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Style="{StaticResource SubtleButton}" Command="{Binding RefreshCommand}" ToolTip="Rescan the current location (or refresh drives)" Margin="4,0,0,0">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="15" />
                </Button>
                <Button Style="{StaticResource SubtleButton}" Command="{Binding OpenSettingsCommand}" ToolTip="Settings" Margin="4,0,0,0">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="15" />
                </Button>
                <Button Style="{StaticResource SubtleButton}" Command="{Binding RestartElevatedCommand}" Margin="4,0,0,0"
                        ToolTip="Restart as administrator to enable fast NTFS MFT scanning"
                        Visibility="{Binding IsElevated, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7EF;" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock Text="Run as admin" Foreground="{DynamicResource App.TextPrimary}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Scan progress -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="16,0,16,10" Padding="16,12"
                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding ProgressHeadline}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                    <ProgressBar Margin="0,8,0,8" Height="4" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" IsIndeterminate="{Binding IsProgressIndeterminate}" />
                    <TextBlock Text="{Binding ProgressPath}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ProgressDetails}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding PauseOrResumeCommand}" MinWidth="96">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="13" Margin="0,0,6,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Text" Value="&#xE769;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                <Setter Property="Text" Value="&#xE768;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Pause" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                <Setter Property="Text" Value="Resume" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding CancelScanCommand}" Margin="8,0,0,0" MinWidth="96">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Cancel" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Result source banner -->
        <Border Grid.Row="2" Margin="16,0,16,10" CornerRadius="6" Padding="12,8"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource App.SubtleFill}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ResultIsStale}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource App.WarningBackground}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border CornerRadius="4" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Top" Background="{DynamicResource App.AccentSubtle}">
                    <TextBlock Text="{Binding ResultSourceText}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource App.TextPrimary}" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource Body}" FontSize="12.5" />
                    <TextBlock Text="{Binding ResultWarning}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding ResultWarning, Converter={StaticResource NullToVis}}" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource LinkButton}" Command="{Binding RescanCommand}" Margin="12,0,0,0" VerticalAlignment="Top"
                        IsEnabled="{Binding IsScanning, Converter={StaticResource Not}}">
                    <TextBlock Text="Rescan now" FontWeight="SemiBold" />
                </Button>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel Margin="8,0,4,12">
                <StackPanel DockPanel.Dock="Bottom" Margin="12,8,8,0">
                    <TextBlock Text="{Binding BackgroundStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Visibility="{Binding BackgroundStatus, Converter={StaticResource NullToVis}}" />
                    <TextBlock Text="{Binding ExportStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Visibility="{Binding ExportStatus, Converter={StaticResource NullToVis}}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNavItem}" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Navigation">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavItem}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="16" Margin="0,0,14,0" />
                                <TextBlock Text="{Binding Label}" FontSize="14" Foreground="{DynamicResource App.TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="8,0,16,16" Focusable="False" />
        </Grid>
    </Grid>
</Window>

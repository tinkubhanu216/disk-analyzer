<UserControl x:Class="DiskAnalyzer.App.Views.NodeDetailsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DiskAnalyzer.App.Controls">
    <!-- DataContext: NodeItemViewModel -->
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{Binding IconBrush}" FontSize="22" Margin="0,0,10,0" />
            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="None" MaxWidth="240" />
        </StackPanel>
        <TextBox Text="{Binding FullPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                 BorderThickness="0" Background="Transparent" Padding="0" Foreground="{DynamicResource App.TextSecondary}" />
        <c:UsageBar Height="6" Value="{Binding ParentRatio}" BarBrush="{Binding BarBrush}" TrackBrush="{DynamicResource App.Track}" Margin="0,0,0,10" />
        <Grid>
            <Grid.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                    <Setter Property="Margin" Value="0,2" />
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Size" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SizeText}" Margin="12,2,0,2" Foreground="{DynamicResource App.TextPrimary}" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Text="Size on disk" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AllocatedText}" Margin="12,2,0,2" Foreground="{DynamicResource App.TextPrimary}" />
            <TextBlock Grid.Row="2" Text="Of parent folder" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PercentOfParentText}" Margin="12,2,0,2" Foreground="{DynamicResource App.TextPrimary}" />
            <TextBlock Grid.Row="3" Text="Of drive capacity" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PercentOfDriveText}" Margin="12,2,0,2" Foreground="{DynamicResource App.TextPrimary}" />
            <TextBlock Grid.Row="4" Text="Files" Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}}" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding FileCountText}" Margin="12,2,0,2" Foreground="{DynamicResource App.TextPrimary}" Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}}" />
            <TextBlock Grid.Row="5" Text="Subfolders" Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}}" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding FolderCountText}" Margin="12,2,0,2" Foreground="{DynamicResource App.TextPrimary}" Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}}" />
            <TextBlock Grid.Row="6" Text="Type" />
            <TextBlock Grid.Row="6" Grid.Column="1" Margin="12,2,0,2" Foreground="{DynamicResource App.TextPrimary}">
                <Run Text="{Binding TypeText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding CategoryText, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Grid.Row="7" Text="Modified" />
            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding ModifiedText}" Margin="12,2,0,2" Foreground="{DynamicResource App.TextPrimary}" />
            <TextBlock Grid.Row="8" Text="Note" Visibility="{Binding Note, Converter={StaticResource NullToVis}}" />
            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Note}" Margin="12,2,0,2" Foreground="{DynamicResource App.Warning}" TextWrapping="Wrap" Visibility="{Binding Note, Converter={StaticResource NullToVis}}" />
        </Grid>
    </StackPanel>
</UserControl>
